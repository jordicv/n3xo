---
// CoverageSection Component - Cobertura Estratégica en Chile
const zones = [
  {
    name: 'Gran Concepción & Región del Biobío',
    badge: 'NUESTRA BASE',
    desc: 'Conocemos la ciudad y sus mejores ubicaciones: avenidas, puentes y accesos de alto flujo en Concepción, Talcahuano, San Pedro y alrededores.',
    points: ['Avenidas principales y centros comerciales', 'Autopistas y accesos a Concepción / Talcahuano / San Pedro', 'Pantallas LED en ubicaciones de alto flujo'],
  },
  {
    name: 'Regiones & Rutas Nacionales',
    badge: 'COBERTURA NACIONAL',
    desc: 'Campañas en cualquier región del país y en las principales rutas y autopistas, con vallas camineras y monopostes de gran formato.',
    points: ['Ruta 5 y principales autopistas concesionadas', 'Campañas en otras regiones a pedido', 'Soportes iluminados, visibles día y noche'],
  },
];
---

<section class="relative py-24 sm:py-32 bg-obsidian-surface border-t border-white/5 overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono uppercase tracking-wider text-brand-silver mb-4">
        <span>COBERTURA</span>
      </div>
      <h2 class="reveal-item font-display font-bold text-3xl sm:text-5xl text-white tracking-tight mb-6">
        Desde Concepción <span class="text-gradient">a todo Chile</span>
      </h2>
      <p class="reveal-item text-brand-silver text-base sm:text-lg leading-relaxed">
        Nuestra base está en Concepción, donde conocemos cada ubicación. Desde aquí coordinamos campañas en cualquier ciudad y ruta del país.
</p>
    </div>

    <!-- Zones Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mb-16">
      {zones.map((zone) => (
        <div class="reveal-item glass-panel rounded-3xl p-6 sm:p-8 flex flex-col justify-between group hover:border-brand-neon/40 transition-all duration-300 hover:-translate-y-1">
          <div>
            <div class="inline-block px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] font-mono text-brand-neon uppercase tracking-wider mb-5">
              {zone.badge}
            </div>
            
            <h3 class="font-display font-bold text-xl sm:text-2xl text-white mb-3 group-hover:text-brand-neon transition-colors">
              {zone.name}
            </h3>

            <p class="text-xs sm:text-sm text-brand-silver leading-relaxed mb-6">
              {zone.desc}
            </p>

            <ul class="space-y-2.5 text-xs text-white/90">
              {zone.points.map((pt) => (
                <li class="flex items-start gap-2">
                  <span class="text-brand-neon font-bold mt-0.5">•</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-6 mt-8 border-t border-white/5">
            <a
              href={`https://wa.me/56932346724?text=Hola%20N3XO%20Chile,%20me%20gustar%C3%ADa%20consultar%20disponibilidad%20en:%20${encodeURIComponent(zone.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-white transition-all"
            >
              <span>Consultar Circuito en esta Zona</span>
              <span class="text-brand-neon">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Live Banner: Video Preview Feature -->
    <div class="reveal-item relative rounded-3xl overflow-hidden glass-panel border border-white/10 p-8 sm:p-12 text-center flex flex-col items-center">
      <div class="max-w-2xl">
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-white mb-3">
          ¿Tienes una ubicación o requerimiento especial en mente?
        </h3>
        <p class="text-xs sm:text-sm text-brand-silver leading-relaxed mb-6">
          Proyectos especiales, intervenciones urbanas, publicidad móvil o campañas en otras regiones. Nos encargamos de evaluar la ubicación y gestionar los permisos.
</p>
        <a
          href="https://wa.me/56932346724?text=Hola%20N3XO,%20necesito%20evaluar%20un%20proyecto%20especial%20o%20ubicaci%C3%B3n%20a%20medida."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-xs font-semibold text-white uppercase tracking-wider hover:scale-105 active:scale-95 transition-all shadow-lg"
        >
          Conversemos
        </a>
      </div>
    </div>

  </div>
</section>
