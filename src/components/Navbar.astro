---
// Navbar Component con Enlaces Reales y Menú Desplegable de Servicios
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Brand -->
      <a href="/" class="flex items-center gap-3 group" aria-label="N3XO.CL Inicio">
        <img
          src="/logos/n3xo-logo-white-purple.png"
          alt="N3XO Logo"
          class="h-10 sm:h-11 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          width="160"
          height="44"
        />
        <div class="hidden sm:flex flex-col border-l border-white/10 pl-3">
          <span class="text-[10px] tracking-widest font-semibold uppercase text-brand-silver">OOH + DIGITAL</span>
          <span class="text-[9px] font-mono text-brand-neon/90">ESTRATEGIAS QUE CONECTAN</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-8">
        
        <!-- 1. Inicio -->
        <a
          href="/"
          class={`text-sm font-medium transition-colors duration-200 ${currentPath === '/' ? 'text-brand-neon font-semibold' : 'text-brand-silver hover:text-white'}`}
        >
          Inicio
        </a>

        <!-- 2. Nosotros -->
        <a
          href="/nosotros"
          class={`text-sm font-medium transition-colors duration-200 ${currentPath === '/nosotros' ? 'text-brand-neon font-semibold' : 'text-brand-silver hover:text-white'}`}
        >
          Nosotros
        </a>

        <!-- 3. Servicios (Dropdown Desplegable) -->
        <div class="relative group" id="services-dropdown-container">
          <button
            type="button"
            id="services-dropdown-btn"
            class={`flex items-center gap-1.5 text-sm font-medium transition-colors duration-200 ${currentPath.startsWith('/servicios') ? 'text-brand-neon font-semibold' : 'text-brand-silver hover:text-white'}`}
            aria-expanded="false"
          >
            <span>Servicios</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu Card (Desktop) -->
          <div
            id="services-menu"
            class="absolute top-full left-1/2 -translate-x-1/2 pt-3 w-80 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 transform origin-top"
          >
            <div class="rounded-2xl glass-panel p-2 shadow-[0_20px_50px_rgba(0,0,0,0.8)] border border-white/10 backdrop-blur-2xl">
              
              <!-- Option 1: OOH -->
              <a
                href="/servicios/ooh"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-white/5 transition-colors group/item"
              >
                <div class="w-8 h-8 rounded-lg bg-brand-violet/20 border border-brand-violet/30 flex items-center justify-center text-brand-neon flex-shrink-0 group-hover/item:scale-105 transition-transform">
                  <svg class="w-4 h-4 text-brand-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="12" rx="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="15" x2="12" y2="21"></line>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-white group-hover/item:text-brand-neon transition-colors">
                    OOH · Marketing en Vía Pública
                  </div>
                  <div class="text-[11px] text-brand-silver line-clamp-1">
                    Soportes urbanos, vallas, pantallas LED y móvil.
                  </div>
                </div>
              </a>

              <!-- Option 2: Sistemas & Software -->
              <a
                href="/servicios/digital"
                class="flex items-start gap-3 p-3 rounded-xl hover:bg-white/5 transition-colors group/item"
              >
                <div class="w-8 h-8 rounded-lg bg-brand-lavender/20 border border-brand-lavender/30 flex items-center justify-center text-brand-lavender flex-shrink-0 group-hover/item:scale-105 transition-transform">
                  <svg class="w-4 h-4 text-brand-lavender" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-white group-hover/item:text-brand-lavender transition-colors">
                    Sistemas, Web & Software
                  </div>
                  <div class="text-[11px] text-brand-silver line-clamp-1">
                    Páginas web, plataformas, automatización e IA.
                  </div>
                </div>
              </a>

              <!-- Hub link -->
              <div class="pt-2 mt-1 border-t border-white/5 px-3 py-1.5">
                <a href="/servicios" class="text-[11px] text-brand-silver hover:text-white transition-colors flex items-center justify-between">
                  <span>Ver resumen de servicios</span>
                  <span class="text-brand-neon">→</span>
                </a>
              </div>

            </div>
          </div>
        </div>

      </nav>

      <!-- Desktop Action CTA: Cotiza -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href="/cotizar"
          class={`relative inline-flex items-center justify-center px-6 py-2.5 text-xs font-semibold tracking-wider uppercase text-white rounded-full overflow-hidden transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] group ${currentPath === '/cotizar' ? 'ring-2 ring-brand-neon' : ''}`}
        >
          <span class="absolute inset-0 bg-gradient-to-r from-brand-violet via-brand-neon to-brand-violet transition-all duration-300 group-hover:opacity-90"></span>
          <span class="relative z-10 flex items-center gap-2">
            Cotiza
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden flex items-center justify-center w-12 h-12 rounded-xl text-white hover:bg-white/5 active:bg-white/10 transition-colors focus:outline-none"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>
</header>

<!-- Mobile Drawer / Overlay outside header to avoid backdrop-filter containing block constraint -->
<div
  id="mobile-menu"
  class="md:hidden fixed inset-x-0 top-20 bottom-0 z-40 bg-obsidian/98 backdrop-blur-3xl border-t border-white/10 hidden flex-col justify-between p-6 overflow-y-auto"
>
  <div class="flex flex-col space-y-3 pt-2">
    
    <!-- Inicio -->
    <a
      href="/"
      class={`mobile-nav-link text-lg font-display font-medium py-3 border-b border-white/5 flex items-center justify-between ${currentPath === '/' ? 'text-brand-neon' : 'text-white/90'}`}
    >
      <span>Inicio</span>
      <span class="text-xs text-brand-silver font-mono">01</span>
    </a>

    <!-- Nosotros -->
    <a
      href="/nosotros"
      class={`mobile-nav-link text-lg font-display font-medium py-3 border-b border-white/5 flex items-center justify-between ${currentPath === '/nosotros' ? 'text-brand-neon' : 'text-white/90'}`}
    >
      <span>Nosotros (Equipo & Modelo)</span>
      <span class="text-xs text-brand-silver font-mono">02</span>
    </a>

    <!-- Servicios Sub-menu in Mobile -->
    <div class="py-2 border-b border-white/5">
      <div class="text-xs font-mono uppercase tracking-wider text-brand-silver mb-2">Servicios N3XO</div>
      <div class="pl-3 space-y-2">
        <a href="/servicios/ooh" class="mobile-nav-link flex items-center justify-between py-2 text-sm text-white/90 hover:text-white">
          <span>• OOH — Marketing en Vía Pública</span>
          <span class="text-[11px] text-brand-silver font-mono">Soportes</span>
        </a>
        <a href="/servicios/digital" class="mobile-nav-link flex items-center justify-between py-2 text-sm text-white/90 hover:text-white">
          <span>• Sistemas, Web & Software</span>
          <span class="text-[11px] text-brand-silver font-mono">Tecnología</span>
        </a>
      </div>
    </div>

    <!-- Cotiza Link in List -->
    <a
      href="/cotizar"
      class={`mobile-nav-link text-lg font-display font-medium py-3 border-b border-white/5 flex items-center justify-between ${currentPath === '/cotizar' ? 'text-brand-neon font-bold' : 'text-white/90'}`}
    >
      <span>Cotiza tu Proyecto</span>
      <span class="text-xs text-brand-neon font-mono">04</span>
    </a>

  </div>

  <!-- Mobile Drawer Footer & CTA -->
  <div class="pt-6 pb-6 border-t border-white/10 space-y-4">
    <a
      href="/cotizar"
      class="mobile-nav-link w-full py-4 text-center text-sm font-semibold tracking-wider uppercase text-white rounded-xl bg-gradient-to-r from-brand-violet to-brand-neon shadow-lg block"
    >
      Cotizar Ahora
    </a>

    <div class="pt-1">
      <a
        href="https://wa.me/56932346724?text=Hola%20N3XO,%20me%20gustar%C3%ADa%20cotizar."
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-3 px-3 rounded-lg bg-white/5 border border-white/10 text-xs font-medium text-brand-silver hover:text-white hover:border-brand-neon/50 w-full"
      >
        <span>Chat WhatsApp N3XO</span>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  const toggleMenu = () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', !isExpanded);
    menu.classList.toggle('hidden');
    menu.classList.toggle('flex');
    hamburgerIcon.classList.toggle('hidden');
    closeIcon.classList.toggle('hidden');
    document.body.classList.toggle('overflow-hidden', !isExpanded);
  };

  menuBtn?.addEventListener('click', toggleMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (!menu.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
