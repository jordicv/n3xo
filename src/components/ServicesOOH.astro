---
// ServicesOOH Component - Publicidad Exterior
const categories = [
  {
    id: 'urbanos',
    title: 'Soportes Urbanos',
    subtitle: 'Presencia constante en las arterias comerciales y peatonales de mayor tráfico.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
    features: [
      'Paletas publicitarias luminosas de doble cara',
      'Vallas y gigantografías de gran visibilidad',
      'Monopostes y estructuras elevadas',
      'Letreros comerciales y volumétricos',
      'Soportes en avenidas y esquinas de alto flujo',
      'Circuitos programados por cobertura urbana',
    ],
    highlight: 'Ideal para recordación de marca, lanzamientos masivos y presencia continua en la ciudad.',
  },
  {
    id: 'camineros',
    title: 'Soportes Camineros',
    subtitle: 'Impacto visual a gran escala en autopistas, accesos y rutas interurbanas de Chile.',
    icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7',
    features: [
      'Vallas carreteras de formato monumental',
      'Monopostes camineros de máxima altura',
      'Soportes en rutas interurbanas y peajes estratégicos',
      'Circuitos de conexión entre ciudades y regiones',
      'Iluminación frontal o backlight para impacto 24/7',
      'Orientación estudiada según flujo vehicular',
    ],
    highlight: 'Especialmente efectivo para marcas de consumo masivo, retail, inmobiliarias y transporte.',
  },
  {
    id: 'dooh',
    title: 'Pantallas LED / DOOH',
    subtitle: 'Digital Out-of-Home: dinamismo, movimiento y flexibilidad de pauta horaria.',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    features: [
      'Pantallas LED urbanas y camineras de ultra alta definición',
      'Publicidad dinámica con reproducción de video y animación',
      'Programación y rotación de contenidos por franjas horarias',
      'Segmentación por días de la semana y horarios peak',
      'Circuitos de pantallas coordinadas en tiempo real',
      'Venta flexible por slots publicitarios e impactos',
    ],
    highlight: 'Máximo impacto visual contemporáneo con capacidad de actualizar mensajes de forma inmediata.',
  },
  {
    id: 'especiales',
    title: 'Proyectos Especiales & BTL',
    subtitle: 'Estructuras no tradicionales, intervenciones de alto impacto y experiencias de marca.',
    icon: 'M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z',
    features: [
      'Instalaciones publicitarias a medida con volumetría 3D',
      'Intervenciones urbanas y ambientaciones en espacios públicos',
      'Branding integral de espacios corporativos y eventos',
      'Activaciones de marca experienciales en puntos neurálgicos',
      'Implementaciones creativas para lanzamientos de productos',
      'Estructuras arquitectónicas publicitarias personalizadas',
    ],
    highlight: 'Generación de viralidad orgánica, relaciones públicas y captación sensorial del consumidor.',
  },
  {
    id: 'movil',
    title: 'OOH Móvil (Branding Vehicular)',
    subtitle: 'Tu marca recorriendo la ciudad día y noche con cobertura por zonas y recorridos.',
    icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
    features: [
      'Branding en microbuses y transporte público urbano',
      'Rotulación de colectivos y vehículos particulares seleccionados',
      'Branding integral o parcial de flotas corporativas',
      'Segmentación por líneas de recorrido y áreas geográficas',
      'Materiales de alta durabilidad con vinilos certificados',
      'Monitoreo de recorridos y cobertura de impacto',
    ],
    highlight: 'Lleva tu mensaje a barrios, avenidas y zonas donde no existe espacio para soportes fijos.',
  },
