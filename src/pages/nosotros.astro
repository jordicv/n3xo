---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ChileGermany from '../components/ChileGermany.astro';
import TeamSection from '../components/TeamSection.astro';
import CoverageSection from '../components/CoverageSection.astro';
import WhatsAppDual from '../components/WhatsAppDual.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Nosotros — Quiénes Somos & Modelo Chile × Alemania | N3XO.CL"
  description="Conoce el equipo directivo de N3XO (Carola, Pame y José) y nuestro modelo estratégico que une la operación publicitaria en Chile con la ingeniería de software desde Alemania."
>
  <Navbar />
  
  <main class="pt-20">
    
    <!-- Header Page Hero -->
    <section class="relative py-20 sm:py-28 bg-obsidian border-b border-white/5 overflow-hidden text-center">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(114,0,255,0.15)_0%,transparent_70%)] pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono uppercase tracking-wider text-brand-neon mb-6">
          <span>FILOSOFÍA & PROPÓSITO N3XO</span>
        </div>
        
        <h1 class="reveal-item font-display font-bold text-4xl sm:text-6xl text-white tracking-tight mb-6">
          Conectar estrategia, creatividad y tecnología para <span class="text-gradient">generar progreso</span>.
        </h1>

        <p class="reveal-item text-base sm:text-xl text-brand-silver leading-relaxed max-w-2xl mx-auto">
          No somos únicamente una agencia de publicidad exterior ni solo una empresa de software: integramos medios físicos, plataformas digitales y capacidades tecnológicas bajo una misma propuesta de valor.
        </p>
      </div>
    </section>

    <!-- 20+ Years Track Record Banner -->
    <section class="py-16 bg-obsidian-surface border-b border-white/5 relative overflow-hidden">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-brand-neon/30 bg-gradient-to-r from-brand-violet/15 via-obsidian-card to-brand-neon/15">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-4 text-center md:text-left">
              <div class="text-5xl sm:text-7xl font-display font-bold text-gradient mb-2">+20 Años</div>
              <div class="text-xs font-mono uppercase tracking-widest text-brand-silver">De Experiencia en Medios</div>
            </div>
            <div class="md:col-span-8 text-sm sm:text-base text-brand-silver leading-relaxed border-t md:border-t-0 md:border-l border-white/10 pt-6 md:pt-0 md:pl-8">
              <p class="text-white font-medium mb-3">
                Una trayectoria forjada en la vía pública de Chile, evolucionando hacia la ingeniería digital.
              </p>
              <p>
                Nuestra operación está respaldada por más de dos décadas de experiencia real: planificación estratégica, gestión de clientes corporativos, permisos y montaje de soportes OOH de alto impacto en todo Chile. Unimos esa sólida experiencia con el desarrollo de software y la innovación tecnológica liderada desde Alemania.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- El Modelo Estratégico Chile x Alemania -->
    <ChileGermany />

    <!-- El Equipo Directivo -->
    <TeamSection />

    <!-- Cobertura Territorial -->
    <CoverageSection />

    <!-- CTA de Cierre hacia Cotizar -->
    <section class="py-20 bg-obsidian-surface border-t border-white/5 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-4">
          ¿Listo para trabajar juntos?
        </h2>
        <p class="text-brand-silver text-sm sm:text-base max-w-xl mx-auto mb-8">
          Conversemos sobre tu próximo soporte de vía pública, tu proyecto de software o una campaña 360° integrada.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/cotizar"
            class="px-8 py-3.5 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider shadow-lg hover:scale-105 active:scale-95 transition-all"
          >
            Solicitar una Propuesta
          </a>
          <a
            href="/servicios"
            class="px-8 py-3.5 rounded-full bg-white/5 border border-white/15 text-white/90 text-xs font-semibold uppercase tracking-wider hover:bg-white/10 transition-all"
          >
            Explorar Servicios
          </a>
        </div>
      </div>
    </section>

  </main>

  <WhatsAppDual />
  <Footer />
</Layout>
