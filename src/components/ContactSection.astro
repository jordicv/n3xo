---
// ContactSection Component - Solicitud de Propuesta y Contacto Directo
import FlagChile from './flags/FlagChile.astro';
import FlagGermany from './flags/FlagGermany.astro';
---

<section id="contacto" class="relative py-24 sm:py-32 bg-obsidian-surface border-t border-white/5 overflow-hidden">
  
  <!-- Subtle Gradient Background -->
  <div class="absolute top-1/2 right-10 w-96 h-96 bg-brand-violet/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Corporate Information & Direct Hubs (5 cols) -->
      <div class="lg:col-span-5">
        <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono uppercase tracking-wider text-brand-neon mb-4">
          <span>COMENCEMOS HOY</span>
        </div>
        
        <h2 class="reveal-item font-display font-bold text-3xl sm:text-5xl text-white tracking-tight mb-6">
          Solicita una <br />
          <span class="text-gradient">Propuesta Comercial</span>
        </h2>

        <p class="reveal-item text-brand-silver text-base leading-relaxed mb-8">
          Conversemos sobre tu próxima campaña en vía pública o tu nuevo desarrollo tecnológico. Estamos disponibles tanto en Chile como en Alemania para responder de forma ágil.
        </p>

        <!-- Direct Offices Contact Cards -->
        <div class="reveal-item space-y-4 mb-8">
          
          <!-- Hub Chile -->
          <div class="glass-panel rounded-2xl p-5 border border-white/10 hover:border-brand-neon/30 transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-brand-neon font-semibold uppercase inline-flex items-center gap-1.5">
                <span>Oficina Chile</span>
                <FlagChile class="w-4 h-3 inline-block" />
              </span>
              <span class="text-[10px] text-brand-silver font-mono">Comercial & OOH</span>
            </div>
            <div class="text-white text-sm font-semibold mb-2">Operación, Soportes & Planificación de Medios</div>
            <div class="flex flex-col gap-1 text-xs text-brand-silver">
              <a href="tel:+56932346724" class="hover:text-white transition-colors flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-brand-neon flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>+56 9 3234 6724</span>
              </a>
              <div class="pt-2 border-t border-white/5 flex flex-col gap-1 text-[11px]">
                <a href="mailto:carola.carrasco@n3xo.cl" class="hover:text-brand-neon transition-colors flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-brand-silver/70 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span>carola.carrasco@n3xo.cl</span>
                </a>
                <a href="mailto:pame.ortega@n3xo.cl" class="hover:text-brand-neon transition-colors flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-brand-silver/70 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span>pame.ortega@n3xo.cl</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Hub Germany -->
          <div class="glass-panel rounded-2xl p-5 border border-white/10 hover:border-brand-lavender/30 transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-brand-lavender font-semibold uppercase inline-flex items-center gap-1.5">
                <span>Tech Hub Alemania</span>
                <FlagGermany class="w-4 h-3 inline-block" />
              </span>
              <span class="text-[10px] text-brand-silver font-mono">Digital & Software</span>
            </div>
            <div class="text-white text-sm font-semibold mb-2">Ingeniería, Plataformas Web & Consultoría</div>
            <div class="flex flex-col gap-1 text-xs text-brand-silver">
              <a href="https://wa.me/491709020413" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-brand-lavender flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.942-.708-1.798s.448-1.277.607-1.451c.16-.175.348-.219.464-.219.116 0 .232.001.333.006.107.005.249-.041.39.297.145.349.493 1.204.536 1.292.043.087.072.19.014.305-.058.116-.087.189-.174.291-.087.102-.183.228-.261.306-.087.087-.179.182-.077.357.102.174.454.748.974 1.211.669.595 1.233.78 1.408.867.174.087.276.073.377-.044.101-.116.435-.508.551-.682.116-.174.232-.145.391-.087.16.058 1.014.478 1.189.565.174.087.29.131.333.204.043.072.043.42-.101.825z"/>
                </svg>
                <span>WhatsApp DE: +49 170 9020413</span>
              </a>
            </div>
          </div>

        </div>

      </div>

      <!-- Right Column: Interactive Proposal Form (7 cols) -->
      <div class="reveal-item lg:col-span-7 glass-panel rounded-3xl p-8 sm:p-10 border border-white/10">
        <h3 class="font-display font-bold text-2xl text-white mb-2">
          Cuéntanos sobre tu proyecto
        </h3>
        <p class="text-xs sm:text-sm text-brand-silver mb-8">
          Completa el formulario y nos contactaremos en menos de 24 horas hábiles.
        </p>

        <form id="contact-form" class="space-y-5">
          
          <!-- Requirement Selector -->
          <div>
            <label class="block text-xs font-mono uppercase tracking-wider text-brand-silver mb-2">
              ¿Qué tipo de solución necesitas? *
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="cursor-pointer">
                <input type="radio" name="service_type" value="Vía Pública & OOH (Chile)" class="peer sr-only" checked />
                <div class="py-3.5 px-4 text-center rounded-xl bg-white/5 border border-white/10 text-xs font-medium text-white/80 peer-checked:border-brand-neon peer-checked:bg-brand-violet/20 peer-checked:text-white transition-all flex items-center justify-center gap-2.5">
                  <svg class="w-4 h-4 text-brand-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="12" rx="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="15" x2="12" y2="21"></line>
                  </svg>
                  <span>Vía Pública & OOH (Chile)</span>
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="service_type" value="Sistemas, Web & Software (Alemania)" class="peer sr-only" />
                <div class="py-3.5 px-4 text-center rounded-xl bg-white/5 border border-white/10 text-xs font-medium text-white/80 peer-checked:border-brand-lavender peer-checked:bg-brand-violet/20 peer-checked:text-white transition-all flex items-center justify-center gap-2.5">
                  <svg class="w-4 h-4 text-brand-lavender" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                  <span>Sistemas, Web & Software</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Name and Company Fields -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-mono uppercase text-brand-silver mb-1.5">Nombre y Apellido *</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Ej. Francisca Silva"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30 text-sm focus:outline-none focus:border-brand-neon focus:ring-1 focus:ring-brand-neon transition-all"
              />
            </div>
            <div>
              <label for="contact-company" class="block text-xs font-mono uppercase text-brand-silver mb-1.5">Empresa o Marca</label>
              <input
                type="text"
                id="contact-company"
                name="company"
                placeholder="Ej. Inmobiliaria Sur"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30 text-sm focus:outline-none focus:border-brand-neon focus:ring-1 focus:ring-brand-neon transition-all"
              />
            </div>
          </div>

          <!-- Email and Phone Fields -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-email" class="block text-xs font-mono uppercase text-brand-silver mb-1.5">Email de Contacto *</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="contacto@tuempresa.cl"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30 text-sm focus:outline-none focus:border-brand-neon focus:ring-1 focus:ring-brand-neon transition-all"
              />
            </div>
            <div>
              <label for="contact-phone" class="block text-xs font-mono uppercase text-brand-silver mb-1.5">Teléfono / WhatsApp *</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                required
                placeholder="+56 9 1234 5678"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30 text-sm focus:outline-none focus:border-brand-neon focus:ring-1 focus:ring-brand-neon transition-all"
              />
            </div>
          </div>

          <!-- Message Field -->
          <div>
            <label for="contact-message" class="block text-xs font-mono uppercase text-brand-silver mb-1.5">Detalles del requerimiento (Ciudad, soporte o tipo de web)</label>
            <textarea
              id="contact-message"
              name="message"
              rows="3"
              placeholder="Indícanos la fecha estimada, ubicación de interés o descripción del proyecto..."
              class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30 text-sm focus:outline-none focus:border-brand-neon focus:ring-1 focus:ring-brand-neon transition-all resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-4 px-6 rounded-full bg-gradient-to-r from-brand-violet via-brand-neon to-brand-violet text-white text-xs font-semibold uppercase tracking-wider shadow-lg hover:shadow-[0_0_30px_rgba(114,0,255,0.4)] transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2"
          >
            <span>Enviar Solicitud de Propuesta</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <!-- Success Alert Message -->
          <div id="form-success" class="hidden p-4 rounded-xl bg-brand-violet/20 border border-brand-neon/40 text-center text-xs text-white items-center justify-center gap-2">
            <svg class="w-4 h-4 text-brand-neon flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>¡Solicitud recibida! Te responderemos de inmediato vía WhatsApp o correo.</span>
          </div>

        </form>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successMsg = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const serviceType = formData.get('service_type');
    const name = formData.get('name');
    const company = formData.get('company') || 'No especificada';
    const email = formData.get('email');
    const phone = formData.get('phone');
    const message = formData.get('message') || 'Sin mensaje adicional';

    // Build WhatsApp message for direct notification
    const text = encodeURIComponent(
      `*Nueva Solicitud Web N3XO.CL*\n` +
      `• *Servicio:* ${serviceType}\n` +
      `• *Nombre:* ${name}\n` +
      `• *Empresa:* ${company}\n` +
      `• *Email:* ${email}\n` +
      `• *Teléfono:* ${phone}\n` +
      `• *Mensaje:* ${message}`
    );

    // Software goes to Germany; default to Chile commercial team
    const targetWa = (serviceType && serviceType.includes('Alemania')) ? '491709020413' : '56932346724';

    // Open synchronously inside the submit gesture so browsers don't block it as a popup
    const waUrl = `https://wa.me/${targetWa}?text=${text}`;
    if (!window.open(waUrl, '_blank')) window.location.href = waUrl;
    form.reset();
    successMsg.classList.remove('hidden');
  });

  // Prefill from links like /cotizar?tipo=digital or /cotizar?tipo=ooh&sub=pantallas
  const params = new URLSearchParams(location.search);
  if (params.get('tipo') === 'digital') {
    form.querySelector('input[value*="Alemania"]').checked = true;
  }
  const subNames = { fijos: 'Soportes fijos', pantallas: 'Pantallas LED', movil: 'Publicidad móvil', especiales: 'Proyectos especiales' };
  if (subNames[params.get('sub')]) {
    document.getElementById('contact-message').value = `Formato de interés: ${subNames[params.get('sub')]}\n`;
  }
</script>
