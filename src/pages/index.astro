---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ClientsBanner from '../components/ClientsBanner.astro';
import SubproductsOOH from '../components/SubproductsOOH.astro';
import TechHubDigital from '../components/TechHubDigital.astro';
import WhatsAppDual from '../components/WhatsAppDual.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="N3XO — Publicidad en Vía Pública en Concepción y Chile | Estrategias que Conectan"
  description="Publicidad en vía pública en Concepción y todo Chile: soportes fijos, pantallas LED, publicidad móvil y proyectos especiales. Además, páginas web y soluciones digitales desde Alemania."
>
  <Navbar />
  
  <main>
    <!-- 1. Hero Cinematográfico con Selector de Entrada (Vía Pública vs. Digital) -->
    <Hero />

    <!-- 2. Franja de Confianza y Marcas (+20 Años de Experiencia) -->
    <ClientsBanner />

    <!-- 3. Marketing en Vía Pública Acotado en Servicios Concretos -->
    <SubproductsOOH />

    <!-- 4. Soluciones Digitales & Tech Hub Alemania (El Área de José) -->
    <TechHubDigital />


    <!-- 5. Banner de Cierre hacia Cotizar -->
    <section class="py-24 bg-obsidian text-center border-t border-white/5 relative overflow-hidden">
      <!-- Ambient Decorative Background Image -->
      <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
        <img
          src="/img/udec-altura.webp"
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover object-center opacity-15"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/90 to-obsidian/85"></div>
      </div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(114,0,255,0.15)_0%,transparent_70%)] pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h2 class="font-display font-bold text-3xl sm:text-5xl text-white mb-4">
          “La tecnología conecta. La estrategia transforma.”
        </h2>
        <p class="text-brand-silver text-sm sm:text-base max-w-xl mx-auto mb-8 leading-relaxed">
          Comencemos a planificar tu próximo circuito publicitario en las principales ciudades o tu nueva plataforma de software corporativa hoy mismo.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/cotizar"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider hover:scale-105 transition-all shadow-lg"
          >
            Iniciar Cotización Personalizada
          </a>
          <a
            href="/nosotros"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white/5 hover:bg-white/10 border border-white/15 text-white text-xs font-semibold uppercase tracking-wider transition-all"
          >
            Conocer a Nuestro Equipo →
          </a>
        </div>
      </div>
    </section>

  </main>

  <WhatsAppDual />
  <Footer />
</Layout>
