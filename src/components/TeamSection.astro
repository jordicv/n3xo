---
// TeamSection Component - Liderazgo N3XO
import FlagChile from './flags/FlagChile.astro';
import FlagGermany from './flags/FlagGermany.astro';

const team = [
  {
    name: 'Carola Carrasco',
    role: 'COO · Directora de Operaciones',
    location: 'Chile',
    isChile: true,
    email: 'carola.carrasco@n3xo.cl',
    desc: 'Empresaria con experiencia en gestión comercial, desarrollo de negocios y asesoría estratégica en diversos sectores. Especialista en negociación, coordinación operativa, gestión de proyectos y desarrollo de relaciones comerciales, con una visión integral orientada a resultados, crecimiento y generación de nuevas oportunidades de negocio.',
    photo: '/team/carola-carrasco.webp',
    tag: 'ESTRATEGIA & MEDIOS',
  },
  {
    name: 'Pamela Ortega',
    role: 'CCO · Directora Comercial',
    location: 'Chile',
    isChile: true,
    email: 'pame.ortega@n3xo.cl',
    desc: 'Profesional especializada en gestión comercial, desarrollo de negocios y relaciones estratégicas con clientes y agencias. Destaca por su orientación comercial, capacidad de negociación y enfoque en la captación de nuevos clientes, generación de alianzas y crecimiento de oportunidades de negocio.',
    photo: '/team/pamela-ortega.webp',
    tag: 'COMERCIAL & CLIENTES',
  },
  {
    name: 'José Ignacio Valdés',
    role: 'Líder Digital & Tecnología',
    location: 'Alemania',
    isChile: false,
    email: null,
    whatsapp: '491709020413',
    desc: 'Desarrollador de software con experiencia en proyectos tecnológicos para grandes marcas y empresas internacionales. Actualmente se desempeña en Alemania en el sector de tecnología médica, contribuyendo al desarrollo de soluciones innovadoras para prótesis médicas. Destaca por su capacidad técnica, pensamiento analítico y orientación a la innovación, integrando tecnología y desarrollo de software para crear soluciones de alto impacto.',
    tag: 'DIGITAL · ALEMANIA',
  },
];
---

<section id="equipo" class="relative py-24 sm:py-32 bg-obsidian border-t border-white/5 overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono uppercase tracking-wider text-brand-silver mb-4">
        <span>+20 AÑOS DE EXPERIENCIA & LIDERAZGO</span>
      </div>
      <h2 class="reveal-item font-display font-bold text-3xl sm:text-5xl text-white tracking-tight mb-6">
        El equipo detrás de <span class="text-gradient">N3XO</span>
      </h2>
      <p class="reveal-item text-brand-silver text-base sm:text-lg leading-relaxed">
        Más de dos décadas de experiencia real y relaciones consolidadas en el mercado publicitario chileno, complementadas con el rigor y desarrollo tecnológico desde Alemania.
      </p>
    </div>

    <!-- Team Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {team.map((member) => (
        <div class="reveal-item glass-panel rounded-3xl p-8 flex flex-col justify-between group hover:border-brand-neon/40 transition-all duration-300 hover:-translate-y-1 relative">
          
          <div>
            <!-- Location Badge -->
            <div class="flex items-center justify-between mb-8">
              <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono text-brand-neon inline-flex items-center gap-1.5">
                <span>{member.location}</span>
                {member.isChile ? (
                  <FlagChile class="w-4 h-3 rounded-[2px] shadow-sm inline-block" />
                ) : (
                  <FlagGermany class="w-4 h-3 rounded-[2px] shadow-sm inline-block" />
                )}
              </span>
              <span class="text-[10px] font-mono uppercase text-brand-silver tracking-wider">
                {member.tag}
              </span>
            </div>

            <!-- Avatar Silhouette / Initial Graphic -->
            <div class="w-20 h-20 rounded-2xl overflow-hidden bg-gradient-to-tr from-brand-violet/30 to-brand-neon/20 border border-brand-neon/30 flex items-center justify-center text-white text-2xl font-display font-bold mb-6 group-hover:scale-105 transition-transform duration-300">
              {member.photo ? (
                <img src={member.photo} alt={member.name} width="160" height="160" class="w-full h-full object-cover" loading="lazy" />
              ) : (
                member.name.charAt(0)
              )}
            </div>

            <!-- Name and Role -->
            <h3 class="font-display font-bold text-2xl text-white mb-1 group-hover:text-brand-neon transition-colors">
              {member.name}
            </h3>
            <p class="text-xs font-mono text-brand-lavender uppercase tracking-wider font-semibold mb-4">
              {member.role}
            </p>

            <p class="text-xs sm:text-sm text-brand-silver leading-relaxed mb-6">
              {member.desc}
            </p>
          </div>

          <!-- Direct Contact Button -->
          <div class="pt-6 border-t border-white/10 mt-auto">
            {member.email ? (
              <a
                href={`mailto:${member.email}`}
                class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-white transition-all group-hover:border-brand-neon/30"
              >
                <svg class="w-4 h-4 text-brand-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span class="truncate">{member.email}</span>
              </a>
            ) : (
              <a
                href={`https://wa.me/${member.whatsapp}?text=Hola%20Jos%C3%A9,%20me%20interesa%20una%20soluci%C3%B3n%20digital%20de%20N3XO.`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-white transition-all group-hover:border-brand-neon/30"
              >
                <FlagGermany class="w-4 h-3 rounded-[2px]" />
                <span>WhatsApp José</span>
                <span class="text-brand-neon">→</span>
              </a>
            )}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
