---

<section id="ooh" class="relative py-24 sm:py-32 bg-obsidian border-t border-white/5 overflow-hidden">
  
  <!-- Subtle Aura Background -->
  <div class="absolute top-1/3 left-0 w-80 h-80 bg-brand-violet/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-3xl">
        <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono uppercase tracking-wider text-brand-neon mb-4">
          <span>01 · PUBLICIDAD EXTERIOR</span>
        </div>
        <h2 class="reveal-item font-display font-bold text-3xl sm:text-5xl text-white tracking-tight">
          Soportes Fijos, Digitales y Móviles <br class="hidden sm:inline" />
          <span class="text-gradient">en todo Chile</span>
        </h2>
        <p class="reveal-item text-brand-silver text-base sm:text-lg mt-4 leading-relaxed">
          Desde grandes carreteras hasta las avenidas urbanas de mayor tráfico. Planificamos, comercializamos e implementamos el circuito de vía pública exacto para tu marca.
        </p>
      </div>

      <!-- Quick CTA Button -->
      <div class="reveal-item flex-shrink-0">
        <a
          href="https://wa.me/56932346724?text=Hola%20N3XO,%20me%20gustar%C3%ADa%20consultar%20disponibilidad%20de%20soportes%20OOH%20en%20Chile."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/5 border border-white/15 text-xs font-semibold tracking-wider uppercase text-white hover:bg-white/10 hover:border-brand-neon/50 transition-all duration-300"
        >
          <span>Consultar Disponibilidad OOH</span>
          <span class="text-brand-neon">→</span>
        </a>
      </div>
    </div>

    <!-- Category Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {categories.map((cat, idx) => (
        <div
          class="reveal-item glass-panel rounded-3xl p-6 sm:p-8 flex flex-col justify-between group hover:border-brand-neon/40 transition-all duration-300 hover:-translate-y-1 relative"
        >
          <div>
            <!-- Top Tag & Icon -->
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-brand-neon group-hover:scale-110 group-hover:bg-brand-violet/20 transition-all duration-300">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={cat.icon} />
                </svg>
              </div>
              <span class="text-xs font-mono text-brand-silver">0{idx + 1}</span>
            </div>

            <h3 class="font-display font-bold text-xl sm:text-2xl text-white mb-2 group-hover:text-brand-neon transition-colors">
              {cat.title}
            </h3>
            <p class="text-xs sm:text-sm text-brand-silver leading-relaxed mb-6">
              {cat.subtitle}
            </p>

            <!-- Features -->
            <ul class="space-y-2.5 text-xs sm:text-sm text-white/90 mb-6">
              {cat.features.slice(0, 4).map((f) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-brand-neon font-bold text-xs mt-0.5">•</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Highlight Box & Direct Quote Action -->
          <div class="pt-6 border-t border-white/10 mt-auto">
            <p class="text-[11px] text-brand-silver/90 italic mb-4">
              "{cat.highlight}"
            </p>
            <a
              href={`https://wa.me/56932346724?text=Hola%20N3XO%20Chile,%20me%20interesa%20cotizar%20la%20categor%C3%ADa%20de%20soportes:%20${encodeURIComponent(cat.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white/5 hover:bg-gradient-to-r hover:from-brand-violet hover:to-brand-neon border border-white/10 hover:border-transparent text-xs font-semibold text-white transition-all duration-300"
            >
              <span>Cotizar {cat.title}</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Commercial Note from Brand Manual -->
    <div class="reveal-item mt-12 p-4 sm:p-5 rounded-2xl bg-white/[0.02] border border-white/5 text-center text-xs text-brand-silver max-w-3xl mx-auto">
      <span class="font-semibold text-white">Transparencia comercial N3XO:</span> Todos los soportes y circuitos se comercializan previa validación técnica de permisos vigentes, condiciones estructurales y disponibilidad en calendario.
    </div>

  </div>
</section>
