---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import IntegrationSection from '../../components/IntegrationSection.astro';
import WhatsAppDual from '../../components/WhatsAppDual.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Phygital (OOH + Digital 360°) — Línea Insignia | N3XO.CL"
  description="Campañas integradas que conectan la publicidad exterior con el mundo digital: códigos QR interactivos con trazabilidad, pantallas LED dinámicas y analítica medible."
>
  <Navbar />

  <main class="pt-20">
    
    <!-- Hero Header -->
    <section class="py-20 sm:py-28 bg-obsidian border-b border-white/5 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(114,0,255,0.25)_0%,transparent_70%)] pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-violet/20 border border-brand-violet/40 text-xs font-mono uppercase tracking-wider text-brand-neon mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-neon animate-pulse"></span>
          <span>LÍNEA INSIGNIA N3XO · INTEGRACIÓN PHYGITAL</span>
        </div>

        <h1 class="reveal-item font-display font-bold text-4xl sm:text-6xl md:text-7xl text-white tracking-tight mb-6">
          El Puente entre la Calle y los Datos: <br />
          <span class="text-gradient">OOH + DIGITAL</span>
        </h1>

        <p class="reveal-item text-base sm:text-xl text-brand-silver max-w-2xl mx-auto leading-relaxed mb-8">
          Convertimos campañas aisladas en experiencias conectadas. El impacto visual en vía pública se transforma en el punto de partida de un embudo digital directo y medible.
        </p>

        <div class="reveal-item flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/cotizar?tipo=integracion"
            class="px-8 py-3.5 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider shadow-lg hover:scale-105 active:scale-95 transition-all"
          >
            Cotizar Campaña Phygital 360°
          </a>
          <a
            href="https://wa.me/56932346724?text=Hola%20N3XO,%20me%20interesa%20planificar%20una%20campa%C3%B1a%20integrada%20OOH%20%2B%20Digital."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-full bg-white/5 border border-white/15 text-white text-xs font-semibold uppercase tracking-wider hover:bg-white/10 transition-all"
          >
            Conversar con un Asesor
          </a>
        </div>
      </div>
    </section>

    <!-- Flagship Integration Component -->
    <IntegrationSection />

    <!-- Bottom Action to Cotizar -->
    <section class="py-20 bg-obsidian-surface text-center border-t border-white/5">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="font-display font-bold text-3xl text-white mb-4">
          Diseñemos una campaña completa para tu marca
        </h2>
        <p class="text-brand-silver text-sm mb-8 leading-relaxed">
          Desde la estructura en la avenida hasta el código QR, la página web de destino y el reporte de atribución. Todo coordinado bajo una sola propuesta transparente.
        </p>
        <a
          href="/cotizar?tipo=integracion"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider hover:scale-105 transition-all shadow-lg"
        >
          Iniciar Propuesta Phygital
        </a>
      </div>
    </section>

  </main>

  <WhatsAppDual />
  <Footer />
</Layout>
