---
// ServicesDigital Component - Servicios Digitales y Tecnología
const digitalServices = [
  {
    title: 'Desarrollo Web & E-commerce',
    tag: 'HIGH-PERFORMANCE',
    desc: 'Sitios corporativos ultrarrápidos, landing pages de máxima conversión y tiendas online con estándares de velocidad y SEO de clase mundial.',
    items: ['Landing pages de alta conversión', 'Sitios web corporativos', 'E-commerce B2B / B2C', 'Sitios multilingües optimizados', 'Core Web Vitals de máxima puntuación'],
  },
  {
    title: 'Software & Plataformas a Medida',
    tag: 'GERMAN ENGINEERING',
    desc: 'Arquitectura y desarrollo de aplicaciones web, sistemas de gestión interna y plataformas escalables creadas desde Alemania.',
    items: ['Sistemas de gestión interna (ERP/CRM)', 'Plataformas web empresariales', 'Integración de APIs y microservicios', 'Arquitectura de software escalable', 'Bases de datos y paneles de control'],
  },
  {
    title: 'Marketing Digital & Contenidos',
    tag: 'GROWTH & STRATEGY',
    desc: 'Estrategias de contenido y presencia en redes sociales diseñadas para construir reputación de marca y apoyar campañas comerciales.',
    items: ['Estrategia digital integral', 'Gestión profesional de redes sociales', 'Creación de contenido y copy estratégico', 'Diseño gráfico publicitario', 'Posicionamiento orgánico (SEO)'],
  },
  {
    title: 'Publicidad Digital & Performance',
    tag: 'PAID MEDIA',
    desc: 'Planificación, ejecución y optimización continua de presupuestos publicitarios en las principales redes de captación.',
    items: ['Campañas de conversión en Meta Ads', 'Google Ads (Búsqueda, Display, YouTube)', 'Estrategias de remarketing segmentado', 'Planificación y distribución de pauta', 'Optimización por costo de adquisición (CPA)'],
  },
  {
    title: 'Analítica, Dashboards & Medición',
    tag: 'DATA INTELLIGENCE',
    desc: 'Transformamos datos dispersos en decisiones claras. Medición responsable distinguiendo interacciones observadas de estimaciones.',
    items: ['Dashboards de control en tiempo real', 'Seguimiento riguroso de conversiones', 'Analítica de tráfico y comportamiento', 'Informes de rendimiento de campañas', 'Visualización de indicadores clave (KPI)'],
  },
  {
    title: 'Automatización & Inteligencia Artificial',
    tag: 'INNOVATION & AI',
    desc: 'Implementación de flujos automatizados e IA aplicada para reducir fricciones operativas y acelerar respuestas al cliente.',
    items: ['Automatización de flujos repetitivos', 'Integración de IA en procesos de negocio', 'Asistentes internos y herramientas a medida', 'Sincronización entre CRM y mensajería', 'Diagnóstico y consultoría tecnológica'],
  },
];
---

<section id="digital" class="relative py-24 sm:py-32 bg-obsidian-surface border-t border-white/5 overflow-hidden">
  
  <!-- Subtle Gradient Background Element -->
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-brand-neon/10 rounded-full blur-[130px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-3xl">
        <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono uppercase tracking-wider text-brand-lavender mb-4">
          <span>02 · DIGITAL & TECNOLOGÍA</span>
        </div>
        <h2 class="reveal-item font-display font-bold text-3xl sm:text-5xl text-white tracking-tight">
          Ingeniería de Software, Plataformas y <br class="hidden sm:inline" />
          <span class="text-gradient">Ecosistemas Digitales</span>
        </h2>
        <p class="reveal-item text-brand-silver text-base sm:text-lg mt-4 leading-relaxed">
          Diseñamos y programamos soluciones digitales con precisión de ingeniería alemana. Desde plataformas a medida hasta campañas de medios pagados y analítica de datos.
        </p>
      </div>

      <!-- Quick CTA Button to Germany Tech Hub -->
      <div class="reveal-item flex-shrink-0">
        <a
          href="https://wa.me/491709020413?text=Hallo%20N3XO%20Germany,%20ich%20interessiere%20mich%20f%C3%BCr%20Software%20und%20Webentwicklung."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/5 border border-white/15 text-xs font-semibold tracking-wider uppercase text-white hover:bg-white/10 hover:border-brand-lavender/50 transition-all duration-300"
        >
          <span>Consultar Tech Lead (Alemania)</span>
          <span class="text-brand-lavender">→</span>
        </a>
      </div>
    </div>

    <!-- Digital Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {digitalServices.map((service, idx) => (
        <div class="reveal-item glass-panel rounded-3xl p-6 sm:p-8 flex flex-col justify-between group hover:border-brand-lavender/40 transition-all duration-300 hover:-translate-y-1 relative">
          <div>
            <!-- Header Badge & Counter -->
            <div class="flex items-center justify-between mb-6">
              <span class="px-2.5 py-1 rounded-full bg-brand-violet/20 border border-brand-violet/30 text-[10px] font-mono text-brand-lavender uppercase tracking-wider font-semibold">
                {service.tag}
              </span>
              <span class="text-xs font-mono text-brand-silver">D-0{idx + 1}</span>
            </div>

            <h3 class="font-display font-bold text-xl sm:text-2xl text-white mb-3 group-hover:text-brand-lavender transition-colors">
              {service.title}
            </h3>

            <p class="text-xs sm:text-sm text-brand-silver leading-relaxed mb-6">
              {service.desc}
            </p>

            <!-- Deliverables -->
            <ul class="space-y-2.5 text-xs sm:text-sm text-white/90 mb-6">
              {service.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-brand-lavender mt-0.5 font-bold">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Action -->
          <div class="pt-6 border-t border-white/10 mt-auto">
            <a
              href={`https://wa.me/491709020413?text=Hola%20N3XO,%20me%20interesa%20conversar%20sobre%20el%20servicio%20digital:%20${encodeURIComponent(service.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white/5 hover:bg-gradient-to-r hover:from-brand-violet hover:to-brand-lavender border border-white/10 hover:border-transparent text-xs font-semibold text-white transition-all duration-300"
            >
              <span>Consultar Proyecto Digital</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
