---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ServicesOOH from '../../components/ServicesOOH.astro';
import CoverageSection from '../../components/CoverageSection.astro';
import WhatsAppDual from '../../components/WhatsAppDual.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Publicidad en Vía Pública en Concepción y Chile (OOH) | N3XO"
  description="Publicidad en vía pública en Concepción y todo Chile: soportes fijos urbanos y camineros, pantallas LED, publicidad móvil y proyectos especiales. Gestionamos ubicaciones, permisos e instalación."
>
  <Navbar />

  <main class="pt-20">
    
    <!-- Hero Header with Decorative Background Image -->
    <section class="py-24 sm:py-32 bg-obsidian border-b border-white/5 text-center relative overflow-hidden">
      <!-- Decorative Background Image with Vivid Contrast -->
      <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
        <img
          src="/img/servicios-ooh-drone.webp"
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover object-center opacity-45 filter contrast-125 saturate-120 brightness-90"
          loading="eager"
        />
        <!-- Protective gradients for maximum legibility and cinematic atmosphere -->
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/80 to-obsidian/45"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(114,0,255,0.25)_0%,transparent_70%)]"></div>
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-xs font-mono uppercase tracking-wider text-brand-neon mb-6 shadow-md">
          <span>OPERACIÓN NACIONAL · VÍA PÚBLICA & MEDIOS</span>
        </div>

        <h1 class="reveal-item font-display font-bold text-4xl sm:text-6xl text-white tracking-tight mb-6 drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
          Marketing en Vía Pública <br />
          <span class="text-gradient">OOH & DOOH</span> en Chile
        </h1>

        <p class="reveal-item text-base sm:text-xl text-gray-200 max-w-2xl mx-auto leading-relaxed mb-8 font-normal drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
          Planificamos, comercializamos e implementamos circuitos publicitarios en las avenidas, autopistas y puntos de mayor flujo de Chile con gestión directa, permisología y montaje técnico integral.
        </p>

        <div class="reveal-item flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/cotizar?tipo=ooh"
            class="px-8 py-3.5 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider shadow-lg hover:scale-105 active:scale-95 transition-all"
          >
            Cotizar Soportes OOH
          </a>
          <a
            href="https://wa.me/56932346724?text=Hola%20N3XO,%20me%20gustar%C3%ADa%20consultar%20por%20disponibilidad%20de%20soportes%20OOH."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-full bg-white/5 border border-white/15 text-white text-xs font-semibold uppercase tracking-wider hover:bg-white/10 transition-all"
          >
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Detailed Services Grid -->
    <ServicesOOH />

    <!-- Coverage Section -->
    <CoverageSection />

    <!-- Bottom Action to Cotizar -->
    <section class="py-20 bg-obsidian text-center border-t border-white/5">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="font-display font-bold text-3xl text-white mb-4">
          ¿Buscando una ubicación o circuito específico?
        </h2>
        <p class="text-brand-silver text-sm mb-8">
          Envíanos tu requerimiento y te enviaremos una ficha técnica detallada con disponibilidad y medidas exactas.
        </p>
        <a
          href="/cotizar?tipo=ooh"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider hover:scale-105 transition-all shadow-lg"
        >
          Iniciar Cotización de Vía Pública
        </a>
      </div>
    </section>

  </main>

  <WhatsAppDual />
  <Footer />
</Layout>
