---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ChileGermany from '../components/ChileGermany.astro';
import TeamSection from '../components/TeamSection.astro';
import CoverageSection from '../components/CoverageSection.astro';
import WhatsAppDual from '../components/WhatsAppDual.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Nosotros — Quiénes Somos & Modelo Chile × Alemania | N3XO.CL"
  description="Conoce el equipo directivo de N3XO (Carola, Pame y José) y nuestro modelo estratégico que une la operación publicitaria en Chile con la ingeniería de software desde Alemania."
>
  <Navbar />
  
  <main class="pt-20">
    
    <!-- Header Page Hero with Ambient Decorative Background Image -->
    <section class="relative py-24 sm:py-32 bg-obsidian border-b border-white/5 overflow-hidden text-center">
      
      <!-- Decorative Background Image with Vivid Contrast -->
      <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
        <img
          src="/img/concepcion-altura.jpg"
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover object-center opacity-45 filter contrast-125 saturate-115 brightness-90"
          loading="eager"
        />
        <!-- Protective gradients for maximum legibility and cinematic atmosphere -->
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/80 to-obsidian/45"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(114,0,255,0.25)_0%,transparent_70%)]"></div>
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-xs font-mono uppercase tracking-wider text-brand-neon mb-6 shadow-md">
          <span>QUIÉNES SOMOS</span>
        </div>

        <h1 class="reveal-item font-display font-bold text-3xl sm:text-5xl text-white tracking-tight drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
          Somos un equipo que combina experiencia, creatividad y nuevas tecnologías para ayudar a las marcas a comunicar mejor y <span class="text-gradient">llegar más lejos</span>.
        </h1>
      </div>
    </section>

    <!-- 20+ Years Track Record Banner -->
    <section class="py-16 bg-obsidian-surface border-b border-white/5 relative overflow-hidden">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-brand-neon/30 bg-gradient-to-r from-brand-violet/15 via-obsidian-card to-brand-neon/15">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-4 text-center md:text-left">
              <div class="text-5xl sm:text-7xl font-display font-bold text-gradient mb-2 tabular-nums">
                +<span id="nosotros-exp-counter" class="inline-block tabular-nums">0</span> Años
              </div>
              <div class="text-xs font-mono uppercase tracking-widest text-brand-silver">De Experiencia en Medios</div>
            </div>
            <div class="md:col-span-8 text-sm sm:text-base text-brand-silver leading-relaxed border-t md:border-t-0 md:border-l border-white/10 pt-6 md:pt-0 md:pl-8">
              <p class="text-white font-medium mb-3">
                Detrás de este proyecto estamos Carola y Pame, profesionales con más de 20 años de trayectoria en publicidad, comunicación y gestión de campañas. A esa experiencia sumamos la mirada digital y tecnológica de José, quien trabaja desde Alemania y aporta una perspectiva conectada con las nuevas formas de comunicar.
              </p>
              <p class="mb-3">
                Hemos trabajado con universidades, inmobiliarias, grandes agencias de medios y marcas de distintos sectores, participando en campañas y proyectos especiales que conectan con las personas de maneras innovadoras. Juntos integramos publicidad exterior (OOH), estrategia digital y nuevas tecnologías para desarrollar soluciones que respondan a los objetivos de cada cliente.
              </p>
              <p>
                Trabajamos entre Chile y Alemania, combinando conocimiento del mercado, cercanía con nuestros clientes e innovación para poner a las marcas en movimiento.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- El Modelo Estratégico Chile x Alemania -->
    <ChileGermany />

    <!-- El Equipo Directivo -->
    <TeamSection />

    <!-- Cobertura Territorial -->
    <CoverageSection />

    <!-- CTA de Cierre hacia Cotizar -->
    <section class="py-20 bg-obsidian-surface border-t border-white/5 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-4">
          ¿Listo para trabajar juntos?
        </h2>
        <p class="text-brand-silver text-sm sm:text-base max-w-xl mx-auto mb-8">
          Conversemos sobre tu próximo soporte de vía pública o tu nuevo desarrollo de software y sistemas.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/cotizar"
            class="px-8 py-3.5 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider shadow-lg hover:scale-105 active:scale-95 transition-all"
          >
            Solicitar una Propuesta
          </a>
          <a
            href="/servicios"
            class="px-8 py-3.5 rounded-full bg-white/5 border border-white/15 text-white/90 text-xs font-semibold uppercase tracking-wider hover:bg-white/10 transition-all"
          >
            Explorar Servicios
          </a>
        </div>
      </div>
    </section>

  </main>

  <WhatsAppDual />
  <Footer />
</Layout>

<script>
  function initNosotrosCounter() {
    const counterEl = document.getElementById('nosotros-exp-counter');
    if (!counterEl) return;

    // Respect reduced motion preference
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      counterEl.textContent = '20';
      return;
    }

    let hasAnimated = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasAnimated) {
            hasAnimated = true;
            observer.disconnect();
            animateCounter();
          }
        });
      },
      { threshold: 0.25 }
    );

    observer.observe(counterEl);

    function animateCounter() {
      const target = 20;
      const duration = 1600; // ms
      const startTime = performance.now();

      function update(currentTime: number) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        // Cubic ease-out
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const currentVal = Math.round(easeOut * target);

        if (counterEl) {
          counterEl.textContent = currentVal.toString();
        }

        if (progress < 1) {
          requestAnimationFrame(update);
        } else if (counterEl) {
          counterEl.textContent = target.toString();
        }
      }

      requestAnimationFrame(update);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNosotrosCounter);
  } else {
    initNosotrosCounter();
  }
  document.addEventListener('astro:page-load', initNosotrosCounter);
</script>
