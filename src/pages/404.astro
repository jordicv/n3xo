---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página no encontrada | N3XO" description="La página que buscas no existe.">
  <Navbar />
  <main class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 pt-20">
    <h1 class="font-display font-bold text-5xl sm:text-7xl text-gradient mb-4">404</h1>
    <p class="text-brand-silver mb-8">La página que buscas no existe o fue movida.</p>
    <a href="/" class="px-8 py-3.5 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider">
      Volver al inicio
    </a>
  </main>
  <Footer />
</Layout>
