---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import TechHubDigital from '../../components/TechHubDigital.astro';
import WhatsAppDual from '../../components/WhatsAppDual.astro';
import Footer from '../../components/Footer.astro';
import FlagGermany from '../../components/flags/FlagGermany.astro';
---

<Layout
  title="Digital & Software — Desarrollo Web e Ingeniería desde Alemania | N3XO.CL"
  description="Desarrollo de páginas web, software a medida, e-commerce, marketing digital, analítica y automatización con IA. Ingeniería de software con estándares alemanes."
>
  <Navbar />

  <main class="pt-20">
    
    <!-- Hero Header with Decorative Background Image -->
    <section class="py-24 sm:py-32 bg-obsidian border-b border-white/5 text-center relative overflow-hidden">
      <!-- Decorative Background Image with Vivid Contrast -->
      <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
        <img
          src="/img/servicios-software-wireframe.webp"
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover object-center opacity-45 filter contrast-125 saturate-110 brightness-85"
          loading="eager"
        />
        <!-- Protective gradients for maximum legibility and cinematic atmosphere -->
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/80 to-obsidian/45"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(196,91,255,0.25)_0%,transparent_70%)]"></div>
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="reveal-item inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-xs font-mono uppercase tracking-wider text-brand-lavender mb-6 shadow-md">
          <span>DIGITAL</span>
        </div>

        <h1 class="reveal-item font-display font-bold text-4xl sm:text-6xl text-white tracking-tight mb-6 drop-shadow-[0_4px_24px_rgba(0,0,0,0.95)]">
          Estrategias <span class="text-gradient">Digitales</span>
        </h1>

        <p class="reveal-item text-base sm:text-xl text-gray-200 max-w-2xl mx-auto leading-relaxed mb-8 font-normal drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
          Desde Alemania, José lidera el área digital: páginas web, sistemas a medida y automatizaciones que ayudan a las empresas a trabajar mejor y llegar más lejos.
        </p>

        <div class="reveal-item flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/cotizar?tipo=digital"
            class="px-8 py-3.5 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider shadow-lg hover:scale-105 active:scale-95 transition-all"
          >
            Cotizar Proyecto Digital
          </a>
          <a
            href="https://wa.me/491709020413?text=Hola%20Jos%C3%A9,%20me%20interesa%20una%20soluci%C3%B3n%20digital%20de%20N3XO."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-full bg-white/5 border border-white/15 text-white text-xs font-semibold uppercase tracking-wider hover:bg-white/10 transition-all"
          >
            Hablar con José (Alemania)
          </a>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <TechHubDigital />

    <!-- German Quality Standards Banner -->
    <section class="py-20 bg-obsidian border-t border-white/5 text-center">
      <div class="max-w-3xl mx-auto px-4">
        <div class="flex justify-center mb-4">
          <FlagGermany class="w-12 h-7.5 rounded shadow-lg ring-1 ring-white/10" />
        </div>
        <h2 class="font-display font-bold text-3xl text-white mb-4">
          Tecnología con Estándar Europeo
        </h2>
        <p class="text-brand-silver text-sm leading-relaxed mb-8">
          Sitios rápidos y seguros, sistemas bien construidos y preparados para crecer junto a tu empresa.
        </p>
        <a
          href="/cotizar?tipo=digital"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-gradient-to-r from-brand-violet to-brand-neon text-white text-xs font-semibold uppercase tracking-wider hover:scale-105 transition-all shadow-lg"
        >
          Iniciar Proyecto de Software o Web
        </a>
      </div>
    </section>

  </main>

  <WhatsAppDual />
  <Footer />
</Layout>
